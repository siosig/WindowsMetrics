<UserControl x:Class="OtlpMonitor.Views.Sections.GpuSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GPU0N: " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding GpuOverall, StringFormat={}{0:0.00}%}" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
