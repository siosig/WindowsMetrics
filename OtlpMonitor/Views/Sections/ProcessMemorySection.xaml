<UserControl x:Class="OtlpMonitor.Views.Sections.ProcessMemorySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OtlpMonitor.Views.Converters">
    <UserControl.Resources>
        <conv:BytesToReadableConverter x:Key="BytesConv"/>
        <conv:TempToColorConverter x:Key="TempColor"/>
    </UserControl.Resources>
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="m: Memory " Foreground="#C5FFFFFF"/>
                <TextBlock Text="min " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding MemMinTempC, StringFormat={}{0:0}°C, FallbackValue=--, TargetNullValue=--}"
                           Foreground="{Binding MemMinTempC, Converter={StaticResource TempColor}}"/>
                <TextBlock Text="  max " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding MemMaxTempC, StringFormat={}{0:0}°C, FallbackValue=--, TargetNullValue=--}"
                           Foreground="{Binding MemMaxTempC, Converter={StaticResource TempColor}}"/>
                <TextBlock Text="  avg " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding MemAvgTempC, StringFormat={}{0:0}°C, FallbackValue=--, TargetNullValue=--}"
                           Foreground="{Binding MemAvgTempC, Converter={StaticResource TempColor}}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding TopMemProc}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       FontSize="{DynamicResource AppFontSizeSmall}" Foreground="#C5FFFFFF"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name}"/><Run Text=":"/><Run Text="{Binding Pid}" Foreground="#60FFFFFF"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MemoryBytes, Converter={StaticResource BytesConv}, FallbackValue=0 B}"
                                       FontSize="{DynamicResource AppFontSizeSmall}" Foreground="White"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
