<UserControl x:Class="OtlpMonitor.Views.Sections.TemperatureSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OtlpMonitor.Views.Converters">
    <UserControl.Resources>
        <conv:TempToColorConverter x:Key="TempColor"/>
    </UserControl.Resources>
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mother: " Foreground="#C5FFFFFF"/>
                <TextBlock Text="SYS " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.SysCelsius, StringFormat={}{0:0}°C, FallbackValue=0°C}"
                           Foreground="{Binding Temperatures.SysCelsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  CPU " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.CpuPackageCelsius, StringFormat={}{0:0}°C, FallbackValue=0°C}"
                           Foreground="{Binding Temperatures.CpuPackageCelsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  MOS " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.MosCelsius, StringFormat={}{0:0}°C, FallbackValue=0°C}"
                           Foreground="{Binding Temperatures.MosCelsius, Converter={StaticResource TempColor}}"
                          />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="PCH " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.PchCelsius, StringFormat={}{0:0}°C, FallbackValue=0°C}"
                           Foreground="{Binding Temperatures.PchCelsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  Sock " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.SockCelsius, StringFormat={}{0:0}°C, FallbackValue=0°C}"
                           Foreground="{Binding Temperatures.SockCelsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  PCIe " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.PcieCelsius, StringFormat={}{0:0}°C, FallbackValue=0°C}"
                           Foreground="{Binding Temperatures.PcieCelsius, Converter={StaticResource TempColor}}"
                          />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="M2 " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.M2Celsius, StringFormat={}{0:0}°C, FallbackValue=0°C}"
                           Foreground="{Binding Temperatures.M2Celsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  Fan1 " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.FanRpm, StringFormat={}{0:0}rpm, FallbackValue=0rpm}"
                           Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
