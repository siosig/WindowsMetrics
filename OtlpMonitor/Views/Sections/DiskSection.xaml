<UserControl x:Class="OtlpMonitor.Views.Sections.DiskSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OtlpMonitor.Views.Converters">
    <UserControl.Resources>
        <conv:BytesToReadableConverter x:Key="BytesConv"/>
        <conv:TempToColorConverter x:Key="TempColor"/>
    </UserControl.Resources>
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <ItemsControl ItemsSource="{Binding Disks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <TextBlock Text="{Binding DriveLetter}" Foreground="#C5FFFFFF" FontFamily="Cascadia Mono" FontSize="11" Width="26"/>
                        <TextBlock Text="{Binding TemperatureCelsius, StringFormat={}{0:0}°C, FallbackValue=---}"
                                   Foreground="{Binding TemperatureCelsius, Converter={StaticResource TempColor}}"
                                   FontFamily="Cascadia Mono" FontSize="11" Width="44"/>
                        <TextBlock Text="{Binding IopsRead, StringFormat={}{0:0.00}MIOPS, FallbackValue=0.00MIOPS}"
                                   Foreground="White" FontFamily="Cascadia Mono" FontSize="11" Width="80"/>
                        <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:0}%, FallbackValue=0%}"
                                   Foreground="White" FontFamily="Cascadia Mono" FontSize="11" Width="30"/>
                        <TextBlock Text=" ↑ " Foreground="#60CDFF" FontSize="11"/>
                        <TextBlock Text="{Binding ReadBytesPerSec, Converter={StaticResource BytesConv}, FallbackValue=0.00}"
                                   Foreground="White" FontFamily="Cascadia Mono" FontSize="11"/>
                        <TextBlock Text=" / ↓ " Foreground="#60CDFF" FontSize="11"/>
                        <TextBlock Text="{Binding WriteBytesPerSec, Converter={StaticResource BytesConv}, FallbackValue=0.00}"
                                   Foreground="White" FontFamily="Cascadia Mono" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
