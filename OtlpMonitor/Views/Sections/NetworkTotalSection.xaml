<UserControl x:Class="OtlpMonitor.Views.Sections.NetworkTotalSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OtlpMonitor.Views.Converters">
    <UserControl.Resources>
        <conv:BytesToReadableConverter x:Key="BytesConv"/>
    </UserControl.Resources>
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Net:" Foreground="#C5FFFFFF" FontFamily="Segoe UI Variable Text" FontSize="11"/>
                <TextBlock Text="{Binding NetInterface, FallbackValue=---}"
                           Foreground="#C5FFFFFF" FontFamily="Cascadia Mono" FontSize="11" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="↑ " Foreground="#60CDFF" FontSize="11"/>
                <TextBlock Text="{Binding NetSend, Converter={StaticResource BytesConv}, FallbackValue=0.00}"
                           Foreground="White" FontFamily="Cascadia Mono" FontSize="11"/>
                <TextBlock Text="  ↓ " Foreground="#60CDFF" FontSize="11"/>
                <TextBlock Text="{Binding NetRecv, Converter={StaticResource BytesConv}, FallbackValue=0.00}"
                           Foreground="White" FontFamily="Cascadia Mono" FontSize="11"/>
            </StackPanel>
            <Canvas x:Name="NetCanvas" Height="24" Margin="0,2,0,0">
                <Polyline x:Name="NetLine" Stroke="#8060CDFF" StrokeThickness="1.5" StrokeLineJoin="Round"/>
            </Canvas>
        </StackPanel>
    </Border>
</UserControl>
