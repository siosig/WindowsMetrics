<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Per-user MSI for the framework-dependent WindowsMetrics build.
    The app is published by Build-Installer.ps1 (PublishSelfContained=false) into
    artifacts/publish-fdd; this project only packages that directory.
    The MSI refuses to install when the .NET 11 Desktop Runtime (x64) is missing.
  -->
  <PropertyGroup>
    <OutputName>WindowsMetrics-$(ProductVersion)-x64</OutputName>
    <ProductVersion Condition="'$(ProductVersion)' == ''">2.1.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish-fdd\</PublishDir>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <!-- Per-user install under %LOCALAPPDATA%Programs: file KeyPaths trigger these ICEs by design. -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
