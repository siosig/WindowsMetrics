<UserControl x:Class="WindowsMetrics.Views.Sections.TemperatureSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsMetrics.Views.Converters"
             xmlns:ctl="clr-namespace:WindowsMetrics.Views.Controls">
    <UserControl.Resources>
        <conv:TempToColorConverter x:Key="TempColor"/>
    </UserControl.Resources>
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mother: " Foreground="#C5FFFFFF"/>
                <TextBlock Text="SYS " Foreground="{StaticResource BoardSysBrush}"/>
                <TextBlock Text="{Binding Temperatures.SysCelsius, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.SysCelsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  CPU " Foreground="{StaticResource BoardCpuBrush}"/>
                <TextBlock Text="{Binding Temperatures.BoardCpuCelsius, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.BoardCpuCelsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  MOS " Foreground="{StaticResource BoardMosBrush}"/>
                <TextBlock Text="{Binding Temperatures.MosCelsius, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.MosCelsius, Converter={StaticResource TempColor}}"
                          />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="PCH " Foreground="{StaticResource BoardPchBrush}"/>
                <TextBlock Text="{Binding Temperatures.PchCelsius, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.PchCelsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  Sock " Foreground="{StaticResource BoardSockBrush}"/>
                <TextBlock Text="{Binding Temperatures.SockCelsius, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.SockCelsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  PCIe " Foreground="{StaticResource BoardPcieBrush}"/>
                <TextBlock Text="{Binding Temperatures.PcieCelsius, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.PcieCelsius, Converter={StaticResource TempColor}}"
                          />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="M2 " Foreground="{StaticResource BoardM2Brush}"/>
                <TextBlock Text="{Binding Temperatures.M2Celsius, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.M2Celsius, Converter={StaticResource TempColor}}"
                          />
                <TextBlock Text="  Fan1 " Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.FanRpm, StringFormat={}{0:0}rpm, TargetNullValue=--}"
                           Foreground="White"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="min " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.MinTempC, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.MinTempC, Converter={StaticResource TempColor}}"/>
                <TextBlock Text="  max " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.MaxTempC, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.MaxTempC, Converter={StaticResource TempColor}}"/>
                <TextBlock Text="  avg " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding Temperatures.AvgTempC, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding Temperatures.AvgTempC, Converter={StaticResource TempColor}}"/>
            </StackPanel>
            <ctl:TrendGraph Height="48" Margin="0,4,0,0"
                            Revision="{Binding BoardTrendRevision}"
                            AutomationProperties.Name="Motherboard temperature trend">
                <ctl:TrendGraph.Lines>
                    <ctl:TrendLine Buffer="{Binding Trends.BoardSys}" Stroke="{StaticResource BoardSysBrush}"/>
                    <ctl:TrendLine Buffer="{Binding Trends.BoardCpu}" Stroke="{StaticResource BoardCpuBrush}"/>
                    <ctl:TrendLine Buffer="{Binding Trends.BoardMos}" Stroke="{StaticResource BoardMosBrush}"/>
                    <ctl:TrendLine Buffer="{Binding Trends.BoardPch}" Stroke="{StaticResource BoardPchBrush}"/>
                    <ctl:TrendLine Buffer="{Binding Trends.BoardSock}" Stroke="{StaticResource BoardSockBrush}"/>
                    <ctl:TrendLine Buffer="{Binding Trends.BoardPcie}" Stroke="{StaticResource BoardPcieBrush}"/>
                    <ctl:TrendLine Buffer="{Binding Trends.BoardM2}" Stroke="{StaticResource BoardM2Brush}"/>
                </ctl:TrendGraph.Lines>
            </ctl:TrendGraph>
        </StackPanel>
    </Border>
</UserControl>
