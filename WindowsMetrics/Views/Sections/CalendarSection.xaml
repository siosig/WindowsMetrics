<UserControl x:Class="WindowsMetrics.Views.Sections.CalendarSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <StackPanel>
            <!-- ヘッダー: 月ナビ -->
            <Grid Margin="0,0,0,4">
                <Button x:Name="PrevBtn" Content="◀" Click="PrevBtn_Click"
                        HorizontalAlignment="Left" Width="20" Height="18"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#80FFFFFF" FontSize="10" Cursor="Hand"/>
                <TextBlock x:Name="MonthLabel" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"/>
                <Button x:Name="NextBtn" Content="▶" Click="NextBtn_Click"
                        HorizontalAlignment="Right" Width="20" Height="18"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#80FFFFFF" FontSize="10" Cursor="Hand"/>
            </Grid>
            <!-- 曜日ヘッダー -->
            <Grid x:Name="DowHeader" Margin="0,0,0,2"/>
            <!-- 日付グリッド -->
            <Grid x:Name="DaysGrid"/>
        </StackPanel>
    </Border>
</UserControl>
