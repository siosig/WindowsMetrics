<UserControl x:Class="WindowsMetrics.Views.Sections.GpuSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:WindowsMetrics.Views.Controls"
             xmlns:conv="clr-namespace:WindowsMetrics.Views.Converters">
    <UserControl.Resources>
        <conv:TempToColorConverter x:Key="TempColor"/>
    </UserControl.Resources>
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GPU:" Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding GpuTemp, StringFormat={}{0:0.0}°C, TargetNullValue=--}" Foreground="White" Margin="4,0,0,0"/>
                <TextBlock Text="{Binding GpuOverall, StringFormat={}  {0:0.00}%}" Foreground="White"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="min " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding GpuMinTempC, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding GpuMinTempC, Converter={StaticResource TempColor}}"/>
                <TextBlock Text="  max " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding GpuMaxTempC, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding GpuMaxTempC, Converter={StaticResource TempColor}}"/>
                <TextBlock Text="  avg " Foreground="#80FFFFFF"/>
                <TextBlock Text="{Binding GpuAvgTempC, StringFormat={}{0:0}°C, TargetNullValue=--}"
                           Foreground="{Binding GpuAvgTempC, Converter={StaticResource TempColor}}"/>
            </StackPanel>
            <ctl:TrendGraph Height="24" Margin="0,2,0,0"
                            Revision="{Binding UsageTrendRevision}"
                            AutomationProperties.Name="GPU usage trend">
                <ctl:TrendGraph.Lines>
                    <ctl:TrendLine Buffer="{Binding Trends.GpuUsage}" Stroke="{StaticResource UsageTrendBrush}"/>
                </ctl:TrendGraph.Lines>
            </ctl:TrendGraph>
            <ItemsControl ItemsSource="{Binding TopGpuProc}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       FontSize="{DynamicResource AppFontSizeSmall}" Foreground="#C5FFFFFF"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name}"/><Run Text=":"/><Run Text="{Binding Pid}" Foreground="#60FFFFFF"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding UsagePercent, StringFormat={}{0:0.0}%, FallbackValue=0.0%}"
                                       FontSize="{DynamicResource AppFontSizeSmall}" Foreground="White"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
