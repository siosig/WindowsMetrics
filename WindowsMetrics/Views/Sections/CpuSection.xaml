<UserControl x:Class="WindowsMetrics.Views.Sections.CpuSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="8" Background="#08FFFFFF" BorderBrush="#12FFFFFF"
            BorderThickness="1" Padding="10,8" Margin="6,3">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CPU:" Foreground="#C5FFFFFF"/>
                <TextBlock Text="{Binding CpuTemp, StringFormat={}{0:0.0}°C, FallbackValue=0.0°C}" Foreground="White" Margin="4,0,0,0"/>
                <TextBlock Text="{Binding CpuTotal, StringFormat={}  {0:0.0}%}" Foreground="White"/>
            </StackPanel>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="C1 " Foreground="#C5FFFFFF" FontSize="{DynamicResource AppFontSizeSmall}"/>
                    <TextBlock Text="{Binding CpuC1, StringFormat={}{0:0}%, FallbackValue=0%}" Foreground="White" FontSize="{DynamicResource AppFontSizeSmall}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="C2 " Foreground="#C5FFFFFF" FontSize="{DynamicResource AppFontSizeSmall}"/>
                    <TextBlock Text="{Binding CpuC2, StringFormat={}{0:0}%, FallbackValue=0%}" Foreground="White" FontSize="{DynamicResource AppFontSizeSmall}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="C3 " Foreground="#C5FFFFFF" FontSize="{DynamicResource AppFontSizeSmall}"/>
                    <TextBlock Text="{Binding CpuC3, StringFormat={}{0:0}%, FallbackValue=0%}" Foreground="White" FontSize="{DynamicResource AppFontSizeSmall}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="DPC " Foreground="#C5FFFFFF" FontSize="{DynamicResource AppFontSizeSmall}"/>
                    <TextBlock Text="{Binding CpuDpc, StringFormat={}{0:0}%, FallbackValue=0%}" Foreground="White" FontSize="{DynamicResource AppFontSizeSmall}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="Int " Foreground="#C5FFFFFF" FontSize="{DynamicResource AppFontSizeSmall}"/>
                    <TextBlock Text="{Binding CpuIntr, StringFormat={}{0:0}%, FallbackValue=0%}" Foreground="White" FontSize="{DynamicResource AppFontSizeSmall}"/>
                </StackPanel>
            </Grid>
            <Canvas x:Name="CpuCanvas" Height="24" Margin="0,2,0,0">
                <Polyline x:Name="CpuLine" Stroke="#8060CDFF" StrokeThickness="1.5" StrokeLineJoin="Round"/>
            </Canvas>
        </StackPanel>
    </Border>
</UserControl>
