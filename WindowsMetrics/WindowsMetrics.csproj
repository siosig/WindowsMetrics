<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.1.0</Version>
  </PropertyGroup>

  <!--
    ExcludeFromSingleFile keeps these as loose files next to the published exe.
    Without it, PublishSingleFile's bundler silently absorbs Assets\app.ico
    (verified via `dotnet publish -v:diag`: it is offered to the GenerateBundle
    task's FilesToBundle, unlike app.png, likely because it doubles as
    ApplicationIcon) instead of copying it, which breaks TrayIconService's
    AppContext.BaseDirectory-relative File.Exists lookup at runtime.
  -->
  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!--
    Single-file self-contained publish (win-x64), matching IMEIndicator's approach.
    Uses PublishRuntimeIdentifier / PublishSelfContained instead of the bare
    RuntimeIdentifier / SelfContained properties: the bare properties also affect
    `dotnet build` (per .NET docs), while the Publish-prefixed ones only apply to
    `dotnet publish` and leave regular debug/release builds untouched.
    PublishTrimmed is false because WinForms relies on COM marshalling and is not
    trim-safe. PublishReadyToRun speeds up startup without requiring trimming.
  -->
  <PropertyGroup>
    <PublishRuntimeIdentifier>win-x64</PublishRuntimeIdentifier>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
