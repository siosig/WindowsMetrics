<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.1.0</Version>
  </PropertyGroup>

  <!--
    The icon is embedded as a manifest resource so the published output is a single exe.
    AppIconResource reads it back by LogicalName.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="WindowsMetrics.Assets.app.ico" />
  </ItemGroup>

  <!--
    Single-file self-contained publish (win-x64), matching IMEIndicator's approach.
    Uses PublishRuntimeIdentifier / PublishSelfContained instead of the bare
    RuntimeIdentifier / SelfContained properties: the bare properties also affect
    `dotnet build` (per .NET docs), while the Publish-prefixed ones only apply to
    `dotnet publish` and leave regular debug/release builds untouched.
    PublishTrimmed is false because WinForms relies on COM marshalling and is not
    trim-safe. PublishReadyToRun speeds up startup without requiring trimming.
    CopyOutputSymbolsToPublishDirectory=false keeps the .pdb in bin/ but out of the
    published output, so publishing yields WindowsMetrics.exe only.
    IncludeAllContentForSelfExtract=true is required on .NET 11: without it the
    exe crashes at startup (BadImageFormatException on the mixed-mode
    DirectWriteForwarder.dll) because that assembly cannot load from the bundle.
  -->
  <PropertyGroup>
    <PublishRuntimeIdentifier>win-x64</PublishRuntimeIdentifier>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
