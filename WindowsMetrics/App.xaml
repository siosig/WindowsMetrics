<Application x:Class="OtlpMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:OtlpMonitor"
             Startup="Application_Startup"
             Exit="Application_Exit"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFontFamily">Cascadia Mono</FontFamily>
            <sys:Double x:Key="AppFontSize">11</sys:Double>
            <sys:Double x:Key="AppFontSizeSmall">9</sys:Double>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
